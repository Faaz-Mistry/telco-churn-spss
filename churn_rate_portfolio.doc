\cell\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=Contract[LEVEL=NOMINAL] MEAN(churn_flag)[name="MEAN_churn_flag"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: Contract=col(source(s), name("Contract"), unit.category())\par   DATA: MEAN_churn_flag=col(source(s), name("MEAN_churn_flag"))\par   GUIDE: axis(dim(1), label("Contract"))\par   GUIDE: axis(dim(2), label("Mean customer"))\par   GUIDE: text.title(label("Churn rate by contract type"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(Contract*MEAN_churn_flag), shape.interior(shape.square))\par END GPL.
