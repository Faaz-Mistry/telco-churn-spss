\cell\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=tenure_band COUNT()[name="COUNT"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: tenure_band=col(source(s), name("tenure_band"), unit.category())\par   DATA: COUNT=col(source(s), name("COUNT"))\par   GUIDE: axis(dim(1), label("tenure_band"))\par   GUIDE: axis(dim(2), label("Count"))\par   SCALE: cat(dim(1), include("1.00", "2.00", "3.00", "4.00"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(tenure_band*COUNT), shape.interior(shape.square))\par END GPL.
