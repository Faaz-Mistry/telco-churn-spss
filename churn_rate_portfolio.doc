\marglsxn1440\margrsxn1440\margtsxn1440\margbsxn1440\pard\plain\s0\ql\fi0\li0\ri0\plain\f1\fs20\cf0 GET\par   FILE='C:\\Users\\faazm\\Downloads\\telco_churn.sav'.\par DATASET NAME DataSet1 WINDOW=FRONT.\par * ---------------------------------------------------------------------\par * 2. DATA CLEANING AND RECODING\par * ---------------------------------------------------------------------\par * TotalCharges is stored as text and has blank values (customers with\par * tenure = 0, i.e. brand-new customers who have not been billed yet).\par COMPUTE TotalChg = NUMBER(TotalCharges, F8.2).\par IF (tenure = 0) TotalChg = 0.\par VARIABLE LABELS TotalChg 'Total charges to date'.\par FORMATS TotalChg (F8.2).\par RECODE Churn ('yes'=1) ('no'=0) INTO churn_flag.\par VARIABLE LABELS  churn_flag 'customer'.\par EXECUTE.\par RECODE tenure (0 thru 12=1) (13 thru 24=2) (25 thru 48=3) (49 thru Highest=4) INTO tenure_band.\par EXECUTE.\par * Chart Builder.\par GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=InternetService[LEVEL=NOMINAL] MEAN(churn_flag)[name="MEAN_churn_flag"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: InternetService=col(source(s), name("InternetService"), unit.category())\par   DATA: MEAN_churn_flag=col(source(s), name("MEAN_churn_flag"))\par   GUIDE: axis(dim(1), label("InternetService"))\par   GUIDE: axis(dim(2), label("Mean customer"))\par   GUIDE: text.title(label("Churn rate by internrt service"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(InternetService*MEAN_churn_flag), shape.interior(shape.square))\par END GPL.\par \par
\pard\plain\sl400\f0 \par \pard\plain\s0\ql\fi0\li0\ri0\plain\f1\fs20\cf0 COMPUTE churn_flag=Churn = "Yes".\par EXECUTE.\par * Chart Builder.\par GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=InternetService[LEVEL=NOMINAL] MEAN(churn_flag)[name="MEAN_churn_flag"] MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: InternetService=col(source(s), name("InternetService"), unit.category())\par   DATA: MEAN_churn_flag=col(source(s), name("MEAN_churn_flag"))\par   GUIDE: axis(dim(1), label("InternetService"))\par   GUIDE: axis(dim(2), label("Mean customer"))\par   GUIDE: text.title(label("Churn rate by internrt service"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: interval(position(InternetService*MEAN_churn_flag), shape.interior(shape.square))\par END GPL.\par \par
\pard\plain\sl400\f0 \par \pard\plain\sl400\f0 \par \pard\plain\s0\ql\fi0\li0\ri0\plain\f3\fs26\b\cf0 \par GGraph\par \b0\par
