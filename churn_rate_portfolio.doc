\cell\pard\plain\intbl\s0\ql\fi0\li0\ri0\sl320\plain\li60\ri60\f3\fs18\cf0 GGRAPH\par   /GRAPHDATASET NAME="graphdataset" VARIABLES=Churn[LEVEL=NOMINAL] MonthlyCharges MISSING=LISTWISE REPORTMISSING=NO\par   /GRAPHSPEC SOURCE=INLINE.\par BEGIN GPL\par   SOURCE: s=userSource(id("graphdataset"))\par   DATA: Churn=col(source(s), name("Churn"), unit.category())\par   DATA: MonthlyCharges=col(source(s), name("MonthlyCharges"))\par   DATA: id=col(source(s), name("$CASENUM"), unit.category())\par   GUIDE: axis(dim(1), label("Customer churned"))\par   GUIDE: axis(dim(2), label("Monthly charges"))\par   GUIDE: text.title(label("Monthly charges by churn status"))\par   SCALE: linear(dim(2), include(0))\par   ELEMENT: schema(position(bin.quantile.letter(Churn*MonthlyCharges)), label(id))\par END GPL.
